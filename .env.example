# ==============================================================================
# CommitMatrix Configuration
# ==============================================================================

# --- Security & API Keys ---
# Dashboard access token required in query string (?token=YOUR_TOKEN)
MATRIX_TOKEN=your_secret_dashboard_token_here

# LLM Provider API Keys (Set at least one based on your chosen MATRIX_MODEL)
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Engine Configuration ---
# Maximum concurrent worker processes for diff evaluation
MATRIX_MAX_WORKERS=6
# Requests Per Minute rate-limiting cap across workers
MATRIX_RPM_LIMIT=15
# LiteLLM model identifier
MATRIX_MODEL=gemini/gemini-2.5-flash-lite

# --- Architecture Blueprint Engine ---
# Enable dynamic architectural context tracking
MATRIX_ARCH_ENABLED=true
MATRIX_ARCH_MODEL=gemini/gemini-2.5-flash-lite
MATRIX_ARCH_MAX_RETRIES=3
MATRIX_ARCH_RETRY_BACKOFF_SEC=20
MATRIX_ARCH_MAX_FILES=8
MATRIX_ARCH_MAX_CHARS_PER_FILE=4000
MATRIX_ARCH_USE_PREVIOUS=true
MATRIX_ARCH_ALLOW_STALE_CONTINUE=ask
MATRIX_ARCH_HEURISTIC_MODE=true
MATRIX_ARCH_MODEL_DIRECTED_MODE=false
MATRIX_ARCH_GENERATOR_VERSION=archgen-v1
# Generation modes: programmatic, llm-single-pass, llm-two-pass, llm-tool-agentic
MATRIX_ARCH_MODE=programmatic
MATRIX_ARCH_SIGNIFICANCE_MODE=heuristic
MATRIX_ARCH_VERBOSE=true

# --- Dashboard & Presentation Layer ---
# Dashboard layout style: 'side' (split-pane console) or 'toast' (floating overlay)
MATRIX_LAYOUT=side
# Terminal overlay auto-close timeout in seconds (Set to 0 to disable)
MATRIX_TIME_AUTOCLOSE=12

# --- Debugging & Chaos Testing ---
# Enable extended pipeline and CLI debug logging
MATRIX_DEBUG=false
# Bypass LLM calls and generate synthetic scores for UI testing
RANDOM_SCORE=false
# Restrict scan depth to last N commits (Uncomment to cap historical depth)
# MATRIX_MAX_COMMITS=15
# Simulate random pipeline failures
MATRIX_STRESS_TEST=false
# MATRIX_CRASH_RATE=0.40
